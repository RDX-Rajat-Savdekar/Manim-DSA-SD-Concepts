---
import "../styles/global.css";
import "../styles/beat-polish.css";
import "../styles/ironman-v2.css";
import "../styles/garage3d.css";
import SiteNav from "../components/SiteNav/SiteNav.astro";
import IronManPage from "../components/ironman-v3/IronManPage.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Mark 85 — Suit story and 3D finale</title>
    <meta name="description" content="Iron Man Mark 85 — GSAP HUD story with a compact 3D suit finale. Astro × GSAP × Webflow Cloud." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="imv2-body">
    <SiteNav current="iron-man" />
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <IronManPage />
      </div>
    </div>
  </body>
</html>
