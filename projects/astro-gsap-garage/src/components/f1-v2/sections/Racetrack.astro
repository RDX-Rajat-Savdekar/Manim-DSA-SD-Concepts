---
---

<section class="f1v2-track-wrap beat-atmosphere" id="track" data-f1-track-section>
  <div class="f1v2-section" style="padding-bottom:1rem">
    <p class="f1v2-kicker">Beat 02 · Sector 1–3</p>
    <h2 class="f1v2-title" data-kinetic style="font-size:clamp(2rem,6vw,3.5rem)">Scroll = throttle</h2>
    <p class="f1v2-lede">
      Your car follows the racing line. Opponents lag behind as speed climbs. Twist the DRS slider for a manual kick.
    </p>
  </div>

  <div class="f1v2-track-sticky" data-f1-track-sticky>
    <div class="f1v2-track-hud">
      <div>
        <div class="f1v2-speed"><span data-f1-speed>0</span><span>km/h</span></div>
        <div style="font-family:var(--f1-mono);font-size:0.68rem;color:var(--f1-muted)">
          sector <span data-f1-sector>1</span> · delta <span data-f1-delta>-0.000</span>
        </div>
      </div>
      <div>
        <label class="f1v2-slider-label" for="f1-drs">DRS / pit limiter</label>
        <input
          id="f1-drs"
          class="f1v2-slider"
          type="range"
          min="0.55"
          max="1.65"
          step="0.01"
          value="1"
          data-f1-drs
        />
      </div>
    </div>

    <svg class="f1v2-track-svg" viewBox="0 0 800 420" data-f1-track-svg>
      <!-- Parallax stands -->
      <rect class="f1v2-stands" data-f1-stand data-plx="0.2" x="40" y="30" width="180" height="36" rx="4" />
      <rect class="f1v2-stands" data-f1-stand data-plx="0.35" x="560" y="50" width="200" height="28" rx="4" />
      <rect class="f1v2-stands" data-f1-stand data-plx="0.15" x="300" y="360" width="220" height="24" rx="4" />

      <!-- Track asphalt -->
      <path
        class="f1v2-track-path"
        d="M120 280 C 120 120, 280 80, 400 140 S 680 120, 700 220 S 620 360, 420 340 S 120 360, 120 280"
      />
      <!-- Racing line (same geometry, thinner) -->
      <path
        class="f1v2-racing-line"
        data-f1-racing-line
        d="M120 280 C 120 120, 280 80, 400 140 S 680 120, 700 220 S 620 360, 420 340 S 120 360, 120 280"
      />

      <!-- Opponent cars (simple) -->
      <g data-f1-opp="0">
        <rect x="-10" y="-5" width="20" height="10" rx="3" fill="#5a6a80" />
      </g>
      <g data-f1-opp="1">
        <rect x="-10" y="-5" width="20" height="10" rx="3" fill="#ff2d55" />
      </g>
      <g data-f1-opp="2">
        <rect x="-9" y="-4" width="18" height="8" rx="2" fill="#c8ff4a" />
      </g>

      <!-- Player car (layered) -->
      <g data-f1-car>
        <ellipse cx="0" cy="6" rx="14" ry="4" fill="#000" opacity="0.35" />
        <rect x="-16" y="-6" width="32" height="12" rx="4" fill="#006f62" />
        <rect x="-8" y="-9" width="14" height="6" rx="2" fill="#003d36" />
        <rect x="8" y="-4" width="10" height="8" rx="2" fill="#7cffc4" />
        <circle data-f1-wheel cx="-10" cy="6" r="3.5" fill="#111" />
        <circle data-f1-wheel cx="10" cy="6" r="3.5" fill="#111" />
      </g>
    </svg>

    <div class="f1v2-minimap" aria-hidden="true">
      <svg viewBox="0 0 100 100">
        <path
          d="M20 70 C 20 30, 40 20, 50 35 S 85 30, 88 50 S 75 85, 50 80 S 20 85, 20 70"
          fill="none"
          stroke="#243830"
          stroke-width="6"
        />
        <circle data-f1-mini-dot r="4" fill="#7cffc4" cx="20" cy="70" />
      </svg>
    </div>
  </div>

</section>
