---
import Hero from "../ironman-v2/sections/Hero.astro";
import Assembly from "../ironman-v2/sections/Assembly.astro";
import Systems from "../ironman-v2/sections/Systems.astro";
import PowerCore from "../ironman-v2/sections/PowerCore.astro";
import Flight from "../ironman-v2/sections/Flight.astro";
import Garage3D from "../shared/Garage3D.astro";
import Close from "../ironman-v2/sections/Close.astro";
import BeatTicker from "../shared/BeatTicker.astro";
---

<main data-im-v3>
  <Hero />
  <BeatTicker
    accent="#f5b301"
    items={["JARVIS ONLINE", "NANOTECH RAIL", "ASSEMBLY", "SUIT PRIMED", "FRIDAY LINK"]}
  />
  <Assembly />
  <BeatTicker
    accent="#ff2a2a"
    items={["ARC REACTOR", "HELMET HUD", "REPULSORS", "BOOT THRUST", "DIAGNOSTIC"]}
  />
  <Systems />
  <BeatTicker accent="#f5b301" items={["CORE CHARGE", "OUTPUT LOCK", "UNIBEAM ARM", "STABLE"]} />
  <PowerCore />
  <BeatTicker accent="#6a80ff" items={["FLIGHT PATH", "ALTITUDE", "MACH CLIMB", "THRUST"]} />
  <Flight />
  <Garage3D
    compact
    theme="iron-man"
    modelSrc="/models/iron-man-rigged.glb"
    animSrc="/models/mixamo-anims.glb"
    kicker="Beat 10 · Interactive finale"
    title="Mark 85 stage"
    lede="Bonus 3D suit after the GSAP story — Mixamo clips, lasers, thrusters. Scroll to scrub the film."
  />
  <Close />
</main>

<script>
  import { initIronManV3 } from "./initIronManV3.js";
  initIronManV3();
</script>
