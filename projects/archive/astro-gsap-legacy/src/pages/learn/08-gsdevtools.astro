---
import LearnLayout from "../../components/Learn/LearnLayout.astro";
---

<LearnLayout title="08 · GSDevTools" session="08">
  <header class="learn-hero">
    <p class="learn-eyebrow">Session 08 · Dev timeline UI</p>
    <h1>The scrubber from the videos</h1>
    <p>
      <strong>GSDevTools</strong> is GSAP’s on-page playback bar: play, pause, scrub, loop,
      speed, in/out points. Use it while building — strip it (or gate it) before a production
      deploy so judges don’t see a debug dock.
    </p>
  </header>

  <section class="learn-section">
    <h2>Live demo</h2>
    <p class="s8-hint">
      A docked control bar should appear at the bottom of the viewport. Drag the playhead —
      the three shapes follow the same timeline you’re scrubbing.
    </p>
    <div class="s8-stage" data-s8-stage>
      <div class="s8-actor s8-actor--a" data-s8-a>A</div>
      <div class="s8-actor s8-actor--b" data-s8-b>B</div>
      <div class="s8-actor s8-actor--c" data-s8-c>C</div>
      <div class="s8-hud">
        <span data-s8-label>label: —</span>
        <span data-s8-time>t = 0.00s</span>
      </div>
    </div>
    <div class="learn-btn-row">
      <button type="button" class="learn-btn learn-btn--solid" data-s8-restart>Restart timeline</button>
    </div>
  </section>

  <section class="learn-section">
    <h2>Minimal wiring</h2>
    <div class="learn-code">{`import { gsap, GSDevTools } from "../../lib/gsap.js";

const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.4 });
tl.to(".a", { x: 120, duration: 0.8 })
  .to(".b", { y: -40, duration: 0.6 }, "-=0.3")
  .to(".c", { scale: 1.3, duration: 0.5 });

GSDevTools.create({
  animation: tl,   // bind THIS timeline
  container: document.body,
  loop: true,
});`}</div>
  </section>

  <section class="learn-section">
    <h2>Useful options</h2>
    <div class="learn-callout">
      <ul style="margin:0;padding-left:1.2rem">
        <li><code>animation</code> — the timeline (or tween) to control</li>
        <li><code>loop</code> — loop toggle default</li>
        <li><code>timeScale</code> — start at 0.5× to study easing</li>
        <li><code>id</code> — name when you have multiple tools on one page</li>
        <li><code>visibility</code> — <code>"auto"</code> / <code>"hidden"</code> keyboard toggle (often <kbd>H</kbd>)</li>
      </ul>
    </div>
    <div class="learn-callout learn-warn">
      Dev only. For your CodeTV entry, either remove <code>GSDevTools.create()</code> or wrap it
      in <code>if (import.meta.env.DEV)</code> so production builds stay clean.
    </div>
  </section>

  <section class="learn-section">
    <h2>Try this</h2>
    <div class="learn-callout">
      <ol style="margin:0;padding-left:1.2rem">
        <li>Scrub slowly through the mid-overlap — that’s the <code>"-=0.3"</code> position param.</li>
        <li>Hit loop / change speed on the dock.</li>
        <li>Set in/out points around just the “B” move and loop that slice.</li>
        <li>Open the script and add a fourth <code>.to()</code> — refresh and scrub the new beat.</li>
      </ol>
    </div>
  </section>

  <nav class="learn-pager">
    <a href="/learn/07-kitchen-sink">← 07</a>
    <a href="/learn">Hub ✓</a>
  </nav>
</LearnLayout>

<script>
  import { gsap, GSDevTools } from "../../lib/gsap.js";

  void GSDevTools;

  const a = document.querySelector("[data-s8-a]");
  const b = document.querySelector("[data-s8-b]");
  const c = document.querySelector("[data-s8-c]");
  const labelEl = document.querySelector("[data-s8-label]");
  const timeEl = document.querySelector("[data-s8-time]");

  const tl = gsap.timeline({
    repeat: -1,
    repeatDelay: 0.5,
    defaults: { ease: "power2.inOut" },
    onUpdate() {
      if (timeEl) timeEl.textContent = `t = ${tl.time().toFixed(2)}s`;
      if (labelEl) labelEl.textContent = `label: ${tl.currentLabel() || "—"}`;
    },
  });

  gsap.set([a, b, c], { clearProps: "transform" });

  tl.addLabel("lift-a")
    .to(a, { x: 100, y: -30, rotation: 12, duration: 0.85 })
    .addLabel("slide-b")
    .to(b, { x: -40, y: 50, scale: 1.15, duration: 0.7 }, "-=0.35")
    .addLabel("pop-c")
    .to(c, { scale: 1.45, y: -55, duration: 0.55 }, "-=0.25")
    .addLabel("reset")
    .to([a, b, c], { x: 0, y: 0, scale: 1, rotation: 0, duration: 0.7, ease: "power3.inOut" });

  GSDevTools.create({
    animation: tl,
    container: document.body,
    loop: true,
    timeScale: 1,
    id: "learn-08",
  });

  document.querySelector("[data-s8-restart]")?.addEventListener("click", () => {
    tl.restart();
  });
</script>
