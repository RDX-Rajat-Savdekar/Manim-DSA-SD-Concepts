---
import "../styles/global.css";
import "../styles/ironman-v2.css";
import SiteNav from "../components/SiteNav/SiteNav.astro";
import IronManPage from "../components/ironman-v2/IronManPage.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Mark 85 — SVG-only v2</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="imv2-body">
    <SiteNav current="iron-man" />
    <p style="position:fixed;top:4.5rem;right:1rem;z-index:40;font:500 0.7rem/1.2 'IBM Plex Mono',monospace;color:#f5b301;background:#120808cc;padding:0.4rem 0.65rem;border-radius:6px">
      SVG v2 · <a href="/iron-man" style="color:#fff">open v3 hybrid →</a>
    </p>
    <IronManPage />
  </body>
</html>
