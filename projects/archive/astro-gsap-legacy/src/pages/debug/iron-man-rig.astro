---
/** Mixamo → Mark 85 retarget lab — compare naive vs restRelative. */
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>DEBUG · Iron Man Mixamo rig</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #0c0c10;
        overflow: hidden;
        font-family: "IBM Plex Mono", ui-monospace, monospace;
        color: #d8ffe0;
      }
      canvas {
        display: block;
        width: 100%;
        height: 100%;
      }
      #panel {
        position: fixed;
        left: 12px;
        top: 12px;
        z-index: 3;
        width: min(340px, calc(100vw - 24px));
        padding: 0.85rem 0.95rem;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(8, 10, 14, 0.88);
        backdrop-filter: blur(10px);
        pointer-events: auto;
      }
      #panel h1 {
        margin: 0 0 0.35rem;
        font-size: 0.78rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #f5b301;
      }
      #status {
        margin: 0 0 0.65rem;
        font-size: 0.68rem;
        color: rgba(216, 255, 224, 0.7);
      }
      label {
        display: grid;
        gap: 0.2rem;
        margin-bottom: 0.55rem;
        font-size: 0.62rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(216, 255, 224, 0.55);
      }
      select,
      button {
        font: inherit;
        font-size: 0.75rem;
        letter-spacing: 0;
        text-transform: none;
        color: #eef5f1;
        background: #16181f;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 6px;
        padding: 0.4rem 0.5rem;
      }
      .row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 0.55rem;
      }
      button {
        cursor: pointer;
      }
      button:hover {
        border-color: #f5b301;
      }
      .check {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 0.55rem;
        font-size: 0.72rem;
        text-transform: none;
        letter-spacing: 0;
        color: rgba(216, 255, 224, 0.85);
      }
      #log {
        margin: 0;
        max-height: 28vh;
        overflow: auto;
        font-size: 0.62rem;
        line-height: 1.45;
        white-space: pre-wrap;
        color: #9fef9f;
      }
      #log.err {
        color: #ff8a8a;
      }
      .hint {
        margin: 0.5rem 0 0;
        font-size: 0.62rem;
        color: rgba(216, 255, 224, 0.45);
        line-height: 1.4;
      }
      a.back {
        color: #7cffc4;
        font-size: 0.65rem;
      }
    </style>
  </head>
  <body>
    <div id="panel">
      <h1>Iron Man · Mixamo retarget</h1>
      <p id="status">Booting…</p>
      <label>
        Mode
        <select id="mode">
          <option value="restRelative" selected>restRelative (fix legs)</option>
          <option value="naive">naive (broken / skinny / flip)</option>
        </select>
      </label>
      <label>
        Clip
        <select id="clip"></select>
      </label>
      <div class="row">
        <button type="button" id="play">Pause</button>
        <button type="button" id="bind">Bind pose</button>
      </div>
      <label class="check">
        <input type="checkbox" id="skel" checked />
        Skeleton helper
      </label>
      <pre id="log"></pre>
      <p class="hint">
        Orbit drag · scroll zoom. Use <strong>restRelative</strong> if legs flip over the head.
        <br />
        <a class="back" href="/iron-man">← /iron-man</a>
        ·
        <a class="back" href="/debug-body">/debug-body</a>
      </p>
    </div>
    <canvas id="c"></canvas>
  </body>
</html>

<script>
  import { initDebugIronManRig } from "../../lib/debugIronManRig.js";
  initDebugIronManRig();
</script>
