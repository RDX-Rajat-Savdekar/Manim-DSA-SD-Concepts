---

<section class="imv2-section imv2-core-wrap" id="core" data-im-core>
  <div>
    <p class="imv2-kicker">Arc reactor</p>
    <h2 class="imv2-title" style="font-size:clamp(2.2rem,7vw,3.8rem)">Unstable → locked</h2>
    <p class="imv2-lede" style="margin-inline:auto">
      Scroll intensity. The reactor schematic charges, then locks to a steady burn.
    </p>
    <div class="imv2-core" data-im-core-orb>
      <img
        class="imv2-core-schematic"
        src="/schematics/iron-man/atom.svg"
        alt=""
        width="128"
        height="128"
        data-im-core-schematic
      />
      <img
        class="imv2-core-zap"
        src="/schematics/iron-man/zap.svg"
        alt=""
        width="48"
        height="48"
        aria-hidden="true"
      />
    </div>
    <p class="imv2-core-label">output <span data-im-core-pct>0</span>%</p>
  </div>
</section>
