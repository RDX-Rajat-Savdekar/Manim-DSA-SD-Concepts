---
---

<section class="f1v2-section" id="telemetry" data-f1-tele>
  <p class="f1v2-kicker">Pit wall</p>
  <h2 class="f1v2-title" style="font-size:clamp(2rem,6vw,3.5rem)">Live numbers</h2>
  <p class="f1v2-lede">Scroll to charge ERS. Counters lock when the board enters view.</p>
  <p class="f1v2-pit" data-f1-pit>awaiting radio…</p>
  <div class="f1v2-tele-grid">
    <div class="f1v2-tele-card">
      <div class="f1v2-tele-card__n">-<span data-f1-count data-to="1.842" data-decimals="3">0</span></div>
      <div class="f1v2-tele-card__l">vs pole (s)</div>
    </div>
    <div class="f1v2-tele-card">
      <div class="f1v2-tele-card__n"><span data-f1-count data-to="324" data-decimals="0">0</span></div>
      <div class="f1v2-tele-card__l">top speed (km/h)</div>
    </div>
    <div class="f1v2-tele-card">
      <div class="f1v2-tele-card__n"><span data-f1-ers-label>0</span>%</div>
      <div class="f1v2-tele-card__l">ERS deploy</div>
      <div class="f1v2-ers"><div class="f1v2-ers__fill" data-f1-ers></div></div>
    </div>
  </div>
</section>
